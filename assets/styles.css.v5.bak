/* Outfit + DM Mono（旧版字体） */
@font-face {
  font-family: "Outfit";
  src: url("./Outfit-Regular.ttf") format("truetype");
  font-weight: 400; font-display: swap;
}
@font-face {
  font-family: "Outfit";
  src: url("./Outfit-Bold.ttf") format("truetype");
  font-weight: 700; font-display: swap;
}
@font-face {
  font-family: "DM Mono";
  src: url("./DMMono-Regular.ttf") format("truetype");
  font-weight: 400; font-display: swap;
}

/* =========================================================
   版权登记服务 · 原型设计系统
   方向：官方证书 / 编辑部排版 / 暖纸底 + 朱砂强调
   ========================================================= */

:root {
  --bg: #FFFFFF;
  --bg-2: #F9F9FC;
  --ink: #020817;
  --ink-2: #243042;
  --muted: #666666;
  --muted-2: #7a8499;
  --line: rgba(36, 87, 255, 0.10);
  --line-soft: rgba(36, 87, 255, 0.06);
  --accent: #3662EC;
  --accent-dark: #2A4CD1;
  --accent-soft: #EEF2FF;
  --accent-2: #2B9957;
  --accent-3: #ff8a3d;
  --paper: var(--bg);
  --paper-2: #F9F9FC;
  --white: var(--bg-2);
  --green: var(--accent-2);
  --green-soft: #e9fbf7;
  --gold: var(--accent-3);
  --gold-soft: #fff1e7;
  --amber: var(--accent-3);
  --amber-soft: #fff1e7;
  --shadow-sm: 0 4px 14px rgba(16, 24, 40, 0.06);
  --shadow-md: 0 16px 48px rgba(16, 24, 40, 0.08);
  --shadow-lg: 0 24px 80px rgba(36, 87, 255, 0.12);
  --radius-sm: 12px;
  --radius-md: 18px;
  --radius-lg: 20px;
  --radius-xl: 24px;
  --font-display: "Outfit", "Noto Sans SC", system-ui, sans-serif;
  --font-sans: "Outfit", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
    "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
  --font-mono: "DM Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  --max: 1160px;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
  --accent-rgb: 54, 98, 236;
  --accent2-rgb: 0, 184, 169;
  --accent3-rgb: 255, 138, 61;
  --ink-rgb: 16, 24, 40;
}

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }
@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  *, *::before, *::after { animation-duration: 0.001ms !important; transition-duration: 0.001ms !important; }
}

body {
  margin: 0;
  background: var(--bg);

img, svg { max-width: 100%; display: block; }
a { color: inherit; text-decoration: none; }
button, input, select, textarea { font: inherit; color: inherit; }
button { cursor: pointer; }
h1, h2, h3, h4, p { margin: 0; }
ul { margin: 0; padding: 0; list-style: none; }

::selection { background: var(--accent); color: #fff; }

.wrap { width: min(calc(100% - 48px), var(--max)); margin-inline: auto; }
@media (max-width: 640px) { .wrap { width: calc(100% - 32px); } }

.skip-link {
  position: fixed; top: -100px; left: 16px; z-index: 999;
  padding: 10px 16px; background: var(--ink); color: #fff; border-radius: 8px;
}
.skip-link:focus { top: 12px; }

/* ---------- 顶部导航 ---------- */
.site-header { position: sticky; top: 14px; z-index: 60; background: transparent; padding: 0 24px; }
.site-header.is-scrolled .nav__pill { border-color: rgba(var(--accent-rgb), 0.22); box-shadow: var(--shadow-md); }
.nav__pill {
  display: flex; align-items: center; gap: 18px;
  padding: 12px 14px 12px 18px;
  background: rgba(255, 255, 255, 0.72);
  border: 1px solid rgba(var(--accent-rgb), 0.12);
  border-radius: 999px;
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  backdrop-filter: blur(20px) saturate(180%);
  box-shadow: var(--shadow-md);
  width: 100%;
}
.nav {
  display: flex; align-items: center; gap: 28px;
  min-height: 72px;
}
.brand { display: flex; align-items: center; gap: 12px; flex-shrink: 0; }
.brand__mark { width: 36px; height: 36px; border-radius: 10px; background: var(--accent); box-shadow: 0 2px 8px rgba(var(--accent-rgb), 0.25); flex-shrink: 0; }
.brand__text strong { display: block; font-size: 16px; letter-spacing: 0.02em; }
.brand__text span { display: block; font-size: 16px; color: var(--muted); letter-spacing: 0.12em; }
.nav__links { display: flex; align-items: center; gap: 26px; margin-left: 12px; }
.nav__links a { font-size: 16px; color: var(--ink-2); position: relative; padding: 8px 0; }
.nav__links a::after {
  content: ""; position: absolute; left: 0; right: 100%; bottom: 2px;
  height: 2px; background: var(--accent); transition: right 0.28s var(--ease);
}
.nav__links a:hover::after, .nav__links a[aria-current="page"]::after { right: 0; }
.nav__actions { margin-left: auto; display: flex; align-items: center; gap: 14px; }
.nav__back { font-size: 16px; color: var(--muted); }
.nav__toggle {
  display: none; width: 40px; height: 40px; border: 1px solid var(--line);
  background: transparent; border-radius: 8px;
}
.nav__toggle span { display: block; width: 18px; height: 2px; background: var(--ink); margin: 4px auto; }

/* ---------- 按钮 ---------- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  min-height: 44px; padding: 0 22px;
  border: 1px solid transparent; border-radius: 999px;
  font-size: 16px; font-weight: 600; letter-spacing: 0.01em;
  transition: transform 0.2s var(--ease), background 0.2s, color 0.2s, border-color 0.2s, box-shadow 0.2s;
  white-space: nowrap;
}
.btn:hover { transform: translateY(-1px); }
.btn:active { transform: translateY(0); }
.btn:focus-visible { outline: 3px solid rgba(var(--accent-rgb), 0.28); outline-offset: 2px; }
.btn--primary { background: var(--accent); color: #fff; border: none; font-weight: 600; letter-spacing: -0.005em; box-shadow: 0 6px 20px rgba(var(--accent-rgb), 0.35); }
.btn--primary:hover { transform: translateY(-2px); box-shadow: 0 18px 42px rgba(var(--accent-rgb), 0.30); }
.btn--primary[disabled] { transform: none; }
.btn--primary:hover { background: var(--accent-dark); }
.btn--dark { background: var(--ink); color: #fff; }
.btn--dark:hover { background: #000; }
.btn--ghost { background: transparent; color: var(--ink); border-color: var(--line); }
.btn--ghost:hover { border-color: var(--ink); }
.btn--text { padding: 0 4px; min-height: 32px; color: var(--accent); }
.btn--block { width: 100%; }
.btn[disabled] { opacity: 0.42; cursor: not-allowed; transform: none; box-shadow: none; }
.btn--lg { min-height: 52px; padding: 0 30px; font-size: 16px; }
.btn--sm { min-height: 36px; padding: 0 16px; font-size: 16px; }

/* ---------- 通用区块 ---------- */
.section { padding: 80px 0; }
.section--tight { padding: 64px 0; }
.section--paper { background: #F9F9FC; }
#why.section--paper { background: url('section2-bg.png') center / cover no-repeat #F9F9FC; }
.section--white { background: var(--white); }
.section--ink { background: var(--ink); color: #fff; }
.eyebrow {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 13px; letter-spacing: 0.18em; color: var(--muted);
  text-transform: uppercase;
}
.eyebrow::before { display: none; }
.section-head { max-width: 760px; margin-bottom: 40px; }
.section-head h2 {
  font-family: var(--font-display);
  font-size: clamp(30px, 3.6vw, 46px);
  line-height: 1.2; letter-spacing: -0.01em;
  margin: 14px 0 14px;
}
.section-head p { color: var(--muted); font-size: 16px; line-height: 1.7; }
.section-head--center { margin-inline: auto; text-align: center; }
.section--ink .section-head p, .section--ink .eyebrow { color: rgba(255,255,255,.6); }
.section--ink .eyebrow::before { display: none; }

/* ---------- Hero ---------- */
.hero { position: relative; overflow: hidden; padding: 64px 0 56px; background: url('banner.png') center / cover no-repeat; }
.hero::before {
  content: ""; position: absolute; inset: 0;
  background: rgba(255, 255, 255, 0.94);
  pointer-events: none;
}
.hero > * { position: relative; z-index: 1; }
.hero__grid {
  position: relative;
  display: grid; grid-template-columns: 1.12fr 0.88fr; gap: 56px; align-items: center;
}
.hero__eyebrow { color: var(--accent); letter-spacing: 0.14em; font-size: 12px; font-weight: 600; }
.hero__eyebrow::before { background: var(--accent); }
.hero h1 {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(44px, 5.5vw, 60px);
  line-height: 1.02;
  letter-spacing: -0.03em;
  color: var(--ink);
  margin-bottom: 22px;
}
/* .hero h1 em 最终版在文件末尾的视觉升级区（渐变） */
.hero__lede { max-width: 520px; font-size: 18px; color: var(--ink-2); line-height: 1.8; }
.hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
.hero__micro { margin-top: 14px; font-size: 12.5px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
.hero__micro svg { width: 14px; height: 14px; }
.hero__facts {
  display: grid; grid-template-columns: repeat(4, 1fr);
  gap: 0; margin-top: 42px; border-top: 1px solid var(--line);
}
.hero__fact { padding: 18px 16px 0 0; }
.hero__fact + .hero__fact { padding-left: 16px; border-left: 1px solid var(--line); }
.hero__fact b { display: block; font-size: 19px; font-family: var(--font-display); letter-spacing: -0.01em; }
.hero__fact span { font-size: 12px; color: var(--muted); }

/* 证书 */
.cert-stage { position: relative; display: grid; place-items: center; min-height: 440px; }
.cert-stage::before {
  content: ""; position: absolute; width: 92%; height: 78%;
  background: var(--accent-soft); border-radius: 34px; transform: rotate(-4deg);
}
.cert-stage::after {
  content: ""; position: absolute; width: 70%; height: 60%;
  background: var(--gold-soft); border-radius: 50%; filter: blur(2px); transform: translate(12%, 18%);
  opacity: .8;
}
.cert {
  position: relative; z-index: 2;
  width: min(100%, 430px);
  background: var(--bg-2);
  border: 1px solid var(--line);
  box-shadow: 0 30px 70px rgba(var(--accent-rgb), 0.16);
  padding: 34px 32px 30px;
  transform: rotate(2.5deg);
}
.cert::before {
  content: ""; position: absolute; inset: 10px; border: 1px solid var(--line-soft); pointer-events: none;
}
.cert__issuer { font-size: 12px; letter-spacing: 0.2em; color: var(--gold); text-align: center; }
.cert__title {
  font-family: var(--font-display); font-size: 27px; text-align: center;
  letter-spacing: 0.22em; margin: 12px 0 6px;
}
.cert__sub { text-align: center; font-size: 12px; color: var(--muted); letter-spacing: 0.16em; }
.cert__body { margin-top: 24px; font-size: 12.5px; color: var(--ink-2); line-height: 2.15; }
.cert__body .line { display: flex; gap: 10px; align-items: baseline; }
.cert__body .line span { color: var(--muted); width: 62px; flex-shrink: 0; font-size: 16px; }
.cert__body .line b { font-family: var(--font-display); font-weight: 600; border-bottom: 1px solid var(--line); flex: 1; }
.cert__seal {
  position: absolute; right: 26px; bottom: 26px;
  width: 84px; height: 84px; border-radius: 50%;
  border: 3px solid rgba(var(--accent-rgb),.72);
  color: rgba(var(--accent-rgb),.8);
  display: grid; place-items: center; text-align: center;
  font-family: var(--font-display); font-size: 16px; line-height: 1.25; letter-spacing: 0.1em;
  transform: rotate(-14deg);
}
.cert__seal::before { content: ""; position: absolute; inset: 5px; border: 1px solid rgba(var(--accent-rgb),.5); border-radius: 50%; }
.cert__no { position: absolute; left: 32px; bottom: 22px; font-size: 12px; color: var(--muted-2); letter-spacing: .08em; }

/* ---------- 对比模块 ---------- */
.compare-layout { display: grid; grid-template-columns: 1.15fr .85fr; gap: 38px; align-items: start; }
.compare {
  --pos: 58%;
  position: relative; border-radius: var(--radius-md); overflow: hidden;
  background: var(--bg-2); border: 1px solid var(--line);
  box-shadow: var(--shadow-md);
  touch-action: pan-y;
}
.compare__canvas { position: relative; aspect-ratio: 4 / 3.35; }
.poster {
  position: absolute; inset: 0;
  background:
    radial-gradient(circle at 78% 18%, rgba(var(--accent-rgb), 0.22) 0, rgba(var(--accent-rgb), 0.22) 26%, transparent 26.2%),
    linear-gradient(160deg, #eaf1ff 0%, #ffffff 100%);
  overflow: hidden;
}
.poster__kicker { position: absolute; left: 8%; top: 10%; font-size: 12px; letter-spacing: .28em; color: var(--muted-2); }
.poster__title {
  position: absolute; left: 8%; top: 16%;
  font-family: var(--font-display); font-size: clamp(30px, 4.2vw, 52px);
  line-height: 1.05; letter-spacing: .04em; color: var(--ink);
}
.poster__title small { display: block; font-family: var(--font-sans); font-size: 16px; letter-spacing: .12em; color: var(--muted-2); margin-top: 10px; }
.poster__product {
  position: absolute; left: 34%; bottom: 6%;
  width: 22%; aspect-ratio: .42; border-radius: 12% 12% 8% 8% / 8% 8% 5% 5%;
  background: linear-gradient(100deg, var(--accent), var(--accent-2) 100%);
  box-shadow: 18px 22px 40px rgba(var(--accent-rgb), 0.28);
  transform: rotate(-4deg);
}
.poster__product::before {
  content: ""; position: absolute; left: 32%; top: -9%; width: 36%; height: 12%;
  background: var(--accent-dark); border-radius: 4px 4px 0 0;
}
.poster__product::after {
  content: "ORIGINAL"; position: absolute; left: 0; right: 0; top: 38%;
  text-align: center; font-size: 7px; letter-spacing: .18em; color: rgba(255,255,255,.85);
}
.poster__copy {
  position: absolute; right: 8%; bottom: 9%; width: 24%;
  text-align: right;
  font-size: 16px; line-height: 1.9; color: var(--muted);
}
.poster__rule { position: absolute; left: 8%; bottom: 32%; width: 18%; height: 1px; background: var(--line); }

.compare__overlay {
  position: absolute; inset: 0;
  clip-path: inset(0 calc(100% - var(--pos)) 0 0);
  background: transparent;
  border-right: 0;
}
.compare__handle {
  position: absolute; top: 0; bottom: 0; left: var(--pos);
  width: 2px; background: var(--accent); z-index: 6; transform: translateX(-1px);
}
.compare__knob {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
  width: 46px; height: 46px; border-radius: 50%;
  background: var(--accent); color: #fff; border: 3px solid #fff;
  box-shadow: 0 6px 18px rgba(0,0,0,.18);
  display: grid; place-items: center; cursor: grab;
}
.compare__knob[data-edge="start"] { left: 0; transform: translate(0, -50%); }
.compare__knob[data-edge="end"] { left: 100%; transform: translate(-100%, -50%); }
.compare__knob:active { cursor: grabbing; }
.compare__knob svg { width: 20px; height: 20px; }
.compare__tag {
  position: absolute; top: 14px; z-index: 7;
  padding: 5px 12px; border-radius: 999px;
  background: var(--accent-dark); color: #fff; font-size: 16px; letter-spacing: .08em;
}
.compare__tag--left { left: 14px; }
.compare__tag--right { right: 14px; background: rgba(var(--accent2-rgb), .9); }

/* 参赛版上的“违规元素” */
.overlay-mark { position: absolute; z-index: 5; }
.overlay-mark .chip {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 6px 10px; border-radius: 6px;
  background: #fff; border: 1px solid var(--line);
  font-size: 12px; color: var(--ink); box-shadow: 0 4px 12px rgba(16, 24, 40, .08);
  white-space: nowrap;
}
.overlay-mark[data-pos="event"] { left: 34%; top: 6%; }
.cap-short { display: none; }
.overlay-mark[data-pos="brand"] { left: 5%; top: 32%; }
.overlay-mark[data-pos="teacher"] { left: 5%; top: 54%; }
.overlay-mark[data-pos="qr"] { left: 5%; bottom: 12%; }
.overlay-mark .badge {
  position: absolute; left: -9px; top: -9px;
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--accent); color: #fff; font-size: 12px;
  display: grid; place-items: center; font-weight: 700;
}
.overlay-mark.is-outlined .chip { outline: 1.5px dashed rgba(var(--accent3-rgb),.8); outline-offset: 3px; }
.qr-chip { display: flex; align-items: center; gap: 8px; }
.qr-chip svg { width: 38px; height: 38px; }
.qr-chip em { font-style: normal; font-size: 8.5px; color: var(--muted-2); }

.compare__legend {
  position: static; z-index: auto;
  padding: 10px 14px;
  border-top: 1px solid var(--line);
  background: transparent; color: var(--muted);
  font-size: 16px; line-height: 1.5;
  display: flex; justify-content: space-between; gap: 12px;
}
.compare__legend span:first-child { max-width: 70%; }
.compare__legend span:last-child { color: var(--accent); white-space: nowrap; }

.compare-side { padding-top: 4px; }
.compare-side h3 { font-family: var(--font-display); font-size: 24px; margin-bottom: 16px; }
.compare-row { display: grid; grid-template-columns: 96px 1fr; gap: 14px; padding: 13px 0; border-top: 1px solid var(--line); }
.compare-row:last-child { border-bottom: 1px solid var(--line); }
.compare-row dt { font-size: 12px; color: var(--muted); }
.compare-row dd { margin: 0; font-size: 13.5px; line-height: 1.6; }
.compare-row dd .no { color: var(--accent); font-weight: 600; }
.compare-row dd .yes { color: var(--green); font-weight: 600; }

.top3 { margin-top: 28px; }
.top3 h4 { font-size: 16px; letter-spacing: .08em; color: var(--muted); margin-bottom: 10px; }
.top3 li { display: flex; gap: 10px; font-size: 16px; padding: 7px 0; border-bottom: 1px dashed var(--line); }
.top3 li b { color: var(--accent); font-family: var(--font-display); font-size: 16px; }

.checklist-link {  
  display: inline-flex; align-items: center; gap: 8px; margin-top: 18px;
  font-size: 16px; color: var(--accent);
  border-bottom: 1px solid rgba(var(--accent-rgb),.35); padding-bottom: 2px;
}

/* ---------- 适用类型 ---------- */
.fit-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
.fit-card {
  background: #fff; border: 1px solid var(--line); border-radius: var(--radius-md);
  padding: 28px; display: flex; flex-direction: column; gap: 14px;
}
.fit-card__head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
.fit-card__label { font-size: 12px; letter-spacing: .1em; }
.pill { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 16px; font-weight: 600; }
.pill--green { background: var(--green-soft); color: var(--green); }
.pill--amber { background: var(--amber-soft); color: var(--amber); }
.pill--red { background: var(--accent-soft); color: var(--accent-dark); }
.fit-card h3 { font-size: 17px; font-family: var(--font-display); font-weight: 600; }
.fit-card p { font-size: 16px; color: var(--muted); }
.fit-card ul { display: flex; flex-direction: column; gap: 8px; margin-top: auto; }
.fit-card li { font-size: 12.5px; color: var(--ink-2); display: flex; gap: 8px; }
.fit-card li::before { content: "·"; color: var(--muted-2); }
.fit-note {
  margin-top: 18px; font-size: 12.5px; color: var(--muted);
  display: flex; gap: 10px; align-items: flex-start; padding: 14px 18px;
  background: var(--gold-soft); border-radius: var(--radius-sm); border: 1px solid rgba(var(--accent3-rgb), 0.28);
}
.fit-note strong { color: var(--ink); }

/* ---------- 流程 ---------- */
.flow { position: relative; display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; }
.flow::before {
  content: ""; position: absolute; left: 4%; right: 4%; top: 34px; height: 1px; background: var(--line);
}
.flow-step { position: relative; padding-top: 0; }
.flow-step__dot {
  width: 68px; height: 68px; border-radius: 50%;
  background: #fff; border: 1px solid var(--line);
  display: grid; place-items: center;
  font-family: var(--font-display); font-size: 23px; color: var(--ink);
  position: relative; z-index: 2; margin-bottom: 18px;
}
.flow-step.is-critical .flow-step__dot { background: var(--accent); color: #fff; border-color: var(--accent); }
.flow-step__time { font-size: 16px; color: var(--muted); letter-spacing: .06em; }
.flow-step h3 { font-size: 16px; margin: 6px 0 6px; }
.flow-step p { font-size: 12.5px; color: var(--muted); line-height: 1.65; }
.flow-step__owner { display: inline-block; margin-top: 8px; font-size: 12px; padding: 2px 8px; border-radius: 4px; background: var(--paper-2); color: var(--muted); }
.refund-line {
  position: relative; margin-top: 34px; padding: 14px 18px;
  border: 1px dashed rgba(var(--accent-rgb),.5); border-radius: var(--radius-sm);
  background: rgba(248,233,229,.55); color: var(--accent-dark);
  font-size: 12.5px; display: flex; align-items: center; gap: 10px;
}
.refund-line svg { width: 16px; height: 16px; flex-shrink: 0; }

/* ---------- 价格 / 退款 ---------- */
.price-grid { display: grid; grid-template-columns: 1fr 1.05fr; gap: 22px; align-items: stretch; }
.price-card {
  background: var(--ink); color: #fff; border-radius: var(--radius-lg);
  padding: 40px; position: relative; overflow: hidden;
}
.price-card::after {
  content: ""; position: absolute; right: -80px; top: -80px; width: 240px; height: 240px;
  border-radius: 50%; border: 1px solid rgba(255,255,255,.14);
}
.price-card__label { font-size: 12px; letter-spacing: .14em; color: rgba(255,255,255,.6); }
.price { display: flex; align-items: baseline; gap: 12px; margin: 16px 0 4px; }
.price b { font-family: var(--font-display); font-size: 64px; line-height: 1; letter-spacing: -.04em; }
.price b small { font-size: 24px; font-weight: 400; margin-right: 2px; }
.price s { color: rgba(255,255,255,.42); font-size: 16px; }
.price__unit { font-size: 12px; color: rgba(255,255,255,.62); }
.price__incl { margin-top: 26px; border-top: 1px solid rgba(255,255,255,.14); padding-top: 22px; display: grid; gap: 10px; }
.price__incl li { display: flex; gap: 10px; font-size: 16px; color: rgba(255,255,255,.85); }
.price__incl svg { width: 16px; height: 16px; flex-shrink: 0; color: var(--accent-2); }
.price-card .btn { margin-top: 28px; }
.price-card__note { font-size: 11.5px; color: rgba(255,255,255,.5); margin-top: 12px; }

.refund-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 32px; }
.refund-card h3 { font-family: var(--font-display); font-size: 22px; margin-bottom: 6px; }
.refund-card p { font-size: 12.5px; color: var(--muted); margin-bottom: 18px; }
.refund-table { width: 100%; border-collapse: collapse; }
.refund-table th, .refund-table td { text-align: left; padding: 12px 10px; border-bottom: 1px solid var(--line-soft); font-size: 12.5px; vertical-align: middle; }
.refund-table th { font-size: 16px; color: var(--muted); font-weight: 500; letter-spacing: .04em; }
.refund-table td:last-child { text-align: right; white-space: nowrap; }
.refund-table tr:last-child td { border-bottom: 0; }
.refund-note { margin-top: 16px; font-size: 11.5px; color: var(--muted); display: flex; gap: 8px; }

/* ---------- 准备清单 ---------- */
.prep-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.prep-item { border-top: 2px solid var(--ink); padding-top: 16px; }
.prep-item b { display: block; font-size: 12px; letter-spacing: .1em; color: var(--muted); margin-bottom: 10px; }
.prep-item h3 { font-size: 16px; margin-bottom: 6px; }
.prep-item p { font-size: 12.5px; color: var(--muted); }
.prep-item .mini { margin-top: 10px; font-size: 11.5px; color: var(--accent); }

/* ---------- FAQ ---------- */
.faq-tools { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
.faq-tab {
  min-height: 36px; padding: 0 16px; border-radius: 999px;
  border: 1px solid var(--line); background: #fff; font-size: 12.5px; color: var(--muted);
}
.faq-tab[aria-selected="true"] { background: var(--ink); color: #fff; border-color: var(--ink); }
.faq-group { display: none; min-height: 280px; }
.faq-group.is-active { display: grid; gap: 12px; }
.faq-group h3 { font-size: 12px; letter-spacing: .12em; color: var(--muted); margin: 26px 0 10px; }
.faq-group h3:first-child { margin-top: 0; }
details.faq {
  background: #fff; border: 1px solid var(--line); border-radius: var(--radius-sm);
  margin-bottom: 10px; overflow: hidden;
}
details.faq summary {
  list-style: none; cursor: pointer; padding: 17px 20px;
  display: flex; align-items: center; gap: 16px; font-size: 16px; font-weight: 500;
}
details.faq summary::-webkit-details-marker { display: none; }
details.faq summary::after {
  content: "+"; margin-left: auto; color: var(--accent); font-size: 20px; line-height: 1; flex-shrink: 0;
  transition: transform .25s var(--ease);
}
details.faq[open] summary::after { transform: rotate(45deg); }
details.faq .answer { padding: 0 20px 20px; color: var(--muted); font-size: 13.5px; line-height: 1.8; }
details.faq .answer strong { color: var(--ink); }

/* ---------- FAQ 补充：退款矩阵 ---------- */
.inline-table { width: 100%; border-collapse: collapse; margin: 12px 0 4px; font-size: 12.5px; }
.inline-table th, .inline-table td { padding: 9px 8px; border-bottom: 1px solid var(--line-soft); text-align: left; }
.inline-table th { font-size: 16px; color: var(--muted); font-weight: 500; }

/* ---------- 页脚 ---------- */
.site-footer { background: var(--ink); color: rgba(255,255,255,.78); padding: 56px 0 34px; }
.footer-grid { display: grid; grid-template-columns: 1.3fr .7fr .7fr .9fr; gap: 32px; }
.site-footer .brand__text strong { color: #fff; }
.site-footer .brand__text span { color: rgba(255,255,255,.45); }
.footer-col h4 { font-size: 16px; letter-spacing: .14em; color: rgba(255,255,255,.42); margin-bottom: 14px; }
.footer-col a, .footer-col p { display: block; font-size: 12.5px; line-height: 2.1; color: rgba(255,255,255,.7); }
.footer-col a:hover { color: #fff; }
.footer-bottom {
  margin-top: 36px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.12);
  display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap;
  font-size: 11.5px; color: rgba(255,255,255,.4);
}

/* ---------- 移动端底栏 ---------- */
.mobile-bar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 70;
  display: none; align-items: center; gap: 14px;
  padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
  background: rgba(255,255,255,.94); border-top: 1px solid var(--line);
  backdrop-filter: blur(12px);
}
.mobile-bar .price-mini { line-height: 1.2; }
.mobile-bar .price-mini b { font-family: var(--font-display); font-size: 22px; }
.mobile-bar .price-mini span { font-size: 12px; color: var(--muted); display: block; }
.mobile-bar .btn { margin-left: auto; flex: 1; max-width: 220px; }

/* ---------- 动效 ---------- */
[data-reveal] { opacity: 0; transform: translateY(16px); transition: opacity .7s var(--ease), transform .7s var(--ease); }
[data-reveal].is-in { opacity: 1; transform: none; }
@media (prefers-reduced-motion: reduce) {
  [data-reveal] { opacity: 1; transform: none; transition: none; }
}

/* =========================================================
   登记流程（register.html）
   ========================================================= */
.funnel-page { background: var(--paper); }
.funnel-top { border-bottom: 1px solid var(--line); background: rgba(255,255,255,.9); backdrop-filter: blur(12px); position: sticky; top: 0; z-index: 50; }
.funnel-top__inner { min-height: 64px; display: flex; align-items: center; gap: 18px; }
.funnel-top__back { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--muted); }
.funnel-top__order { margin-left: auto; font-size: 11.5px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
.funnel-top__order strong { color: var(--ink); font-weight: 600; }

.stepper { display: flex; align-items: center; gap: 0; padding: 30px 0 8px; }
.stepper__item { display: flex; align-items: center; gap: 10px; flex: 0 0 auto; }
.stepper__num {
  width: 28px; height: 28px; border-radius: 50%;
  border: 1px solid var(--line); background: #fff; color: var(--muted);
  display: grid; place-items: center; font-size: 12px;
}
.stepper__item.is-active .stepper__num { background: var(--accent); color: #fff; border-color: var(--accent); }
.stepper__item.is-done .stepper__num { background: var(--green); color: #fff; border-color: var(--green); }
.stepper__label { font-size: 12.5px; color: var(--muted); white-space: nowrap; }
.stepper__item.is-active .stepper__label { color: var(--ink); font-weight: 600; }
.stepper__line { flex: 1; height: 1px; background: var(--line); margin: 0 14px; min-width: 24px; }

.funnel-shell { display: grid; grid-template-columns: 1fr; gap: 34px; align-items: start; padding: 20px 0 100px; }
.funnel-main { min-width: 0; }
.funnel-step { display: none; animation: fadeUp .45s var(--ease) both; }
.funnel-step.is-active { display: block; }
@keyframes fadeUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

/* 漏斗页前置对比模块 */
.funnel-compare {
  margin-bottom: 28px;
  padding: 26px;
  background: var(--bg-2);
  border: 1px solid rgba(var(--accent-rgb), 0.08);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}
.funnel-compare__head { margin-bottom: 20px; }
.funnel-compare__tag {
  display: inline-block; font-size: 16px; font-weight: 700; letter-spacing: .06em;
  padding: 4px 12px; border-radius: 999px;
  background: linear-gradient(135deg, rgba(var(--accent-rgb), 0.12), rgba(var(--accent2-rgb), 0.14));
  color: var(--accent); margin-bottom: 10px;
}
.funnel-compare__head h2 {
  font-family: var(--font-display); font-size: 22px; line-height: 1.3; margin-bottom: 8px;
  letter-spacing: -0.01em;
}
.funnel-compare__head p { font-size: 16px; color: var(--muted); line-height: 1.7; max-width: 580px; }
.funnel-compare { max-width: 520px; margin: 0 auto 28px; }
.funnel-compare__tips, .compare-tips {
  margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--line);
  display: flex; gap: 12px; flex-wrap: wrap; justify-content: center;
}
.funnel-compare__tips span, .compare-tips span {
  font-size: 11.5px; color: var(--muted);
  display: inline-flex; gap: 4px; align-items: center;
}
.funnel-compare__tips b, .compare-tips b { color: var(--ink); font-weight: 600; }
.funnel-compare .overlay-mark[data-pos="event"] { left: 34%; top: 6%; }
.funnel-compare .overlay-mark[data-pos="teacher"] { left: 5%; top: 48%; }

.step-head { margin-bottom: 28px; }
.step-head h1 { font-family: var(--font-display); font-size: clamp(28px, 3.2vw, 38px); line-height: 1.2; margin-bottom: 10px; }
.step-head p { font-size: 16px; line-height: 1.7; color: var(--muted); max-width: 640px; }
.step-head__meta { display: flex; align-items: center; gap: 12px; margin-top: 12px; flex-wrap: wrap; }
.step-actions { display: flex; justify-content: flex-end; margin-top: 26px; }

.notice-list { display: grid; gap: 12px; }
.notice {
  background: #fff; border: 1px solid var(--line); border-radius: var(--radius-md);
  padding: 22px 22px 20px; transition: border-color .2s, background .2s;
}
.notice.is-checked { border-color: rgba(var(--accent-rgb), .45); background: var(--accent-soft); }
.notice__top { display: flex; gap: 14px; align-items: flex-start; }
.notice__num {
  width: 30px; height: 30px; border-radius: 8px; flex-shrink: 0;
  background: var(--paper-2); color: var(--ink); display: grid; place-items: center;
  font-family: var(--font-display); font-size: 16px;
}
.notice__top h3 { font-size: 19px; margin-bottom: 6px; }
.notice__top p { font-size: 14.5px; line-height: 1.7; color: var(--muted); }
.notice__body { margin-top: 14px; font-size: 14.5px; color: var(--ink-2); line-height: 1.75; }
.notice__body ul { display: grid; gap: 8px; }
.notice__body li { position: relative; padding-left: 18px; }
.notice__body li::before {
  content: ""; position: absolute; left: 2px; top: .62em;
  width: 5px; height: 5px; border-radius: 50%; background: var(--muted-2);
}
.notice__body .key { font-weight: 700; color: #d93025; }
.notice__body .warn { font-weight: 700; color: #d93025; }
.notice__check {
  display: flex; align-items: center; gap: 10px; margin: 18px 0 0 44px;
  font-size: 14px; color: var(--muted); cursor: pointer; user-select: none;
}
.notice__check input { position: absolute; opacity: 0; pointer-events: none; }
.checkbox {
  width: 20px; height: 20px; border-radius: 5px; border: 1px solid var(--line);
  display: grid; place-items: center; background: #fff; flex-shrink: 0;
  transition: background .2s, border-color .2s;
}
.checkbox svg { width: 12px; height: 12px; opacity: 0; color: #fff; transition: opacity .2s; }
input:checked + .checkbox { background: var(--green); border-color: var(--green); }
input:checked + .checkbox svg { opacity: 1; }
input:focus-visible + .checkbox { outline: 3px solid rgba(var(--accent2-rgb), .22); outline-offset: 2px; }

.read-progress {
  margin: 20px 0 24px; display: flex; align-items: center; gap: 14px;
  font-size: 14px; color: var(--muted);
}
.read-progress__bar { flex: 1; height: 6px; background: var(--paper-2); border-radius: 999px; overflow: hidden; }
.read-progress__bar i { display: block; height: 100%; width: 0%; background: var(--green); border-radius: 999px; transition: width .35s var(--ease); }

.prep-mini { margin-top: 24px; padding: 18px 20px; border: 1px solid var(--line); border-radius: var(--radius-md); background: var(--paper-2); }
.prep-mini h4 { font-size: 15px; letter-spacing: .04em; color: var(--ink); margin-bottom: 12px; }
.prep-mini ul { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; }
.prep-mini li { font-size: 14px; color: var(--ink-2); display: flex; gap: 8px; }
.prep-mini .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-top: 8px; flex-shrink: 0; }

/* 摘要卡 */
.summary-card {
  position: sticky; top: 84px;
  background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg);
  padding: 24px; box-shadow: var(--shadow-sm);
}
.summary-card__label { font-size: 16px; letter-spacing: .12em; color: var(--muted); }
.summary-card__price { display: flex; align-items: baseline; gap: 10px; margin: 8px 0 2px; }
.summary-card__price b { font-family: var(--font-display); font-size: 36px; letter-spacing: -.03em; }
.summary-card__price b small { font-size: 16px; font-weight: 400; }
.summary-card__price s { color: var(--muted-2); font-size: 12px; }
.summary-card__rows { margin-top: 18px; border-top: 1px solid var(--line-soft); padding-top: 14px; display: grid; gap: 10px; }
.summary-row { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; }
.summary-row span { color: var(--muted); }
.summary-row strong { font-weight: 500; text-align: right; }
.summary-card__note { margin-top: 16px; padding: 12px; border-radius: 10px; background: var(--gold-soft); font-size: 11.5px; color: #a84e1a; display: flex; gap: 8px; line-height: 1.6; }
.summary-card__note svg { width: 14px; height: 14px; flex-shrink: 0; margin-top: 2px; }
.summary-card .btn { margin-top: 18px; }
.summary-card__micro { font-size: 12px; color: var(--muted); text-align: center; margin-top: 8px; }

/* 表单 */
.form-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 28px; }
.form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
.field { display: flex; flex-direction: column; gap: 7px; }
.field--full { grid-column: 1 / -1; }
.field label { font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 6px; }
.field label .req { color: var(--accent); }
.field .hint { font-size: 11.5px; color: var(--muted); line-height: 1.6; }
.input, .select, .textarea {
  width: 100%; min-height: 46px; padding: 10px 14px;
  border: 1px solid var(--line); border-radius: 10px; background: #fff;
  font-size: 16px; transition: border-color .2s, box-shadow .2s;
}
.input::placeholder, .textarea::placeholder { color: var(--muted-2); }
.input:focus, .select:focus, .textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(var(--accent-rgb),.12); }
.input[aria-invalid="true"], .select[aria-invalid="true"] { border-color: var(--accent); background: rgba(var(--accent-rgb), 0.05); }
.textarea { min-height: 110px; resize: vertical; }
.counter { font-size: 12px; color: var(--muted); text-align: right; }
.with-suffix { position: relative; }
.with-suffix .input { padding-right: 116px; }
.with-suffix .suffix-btn { position: absolute; right: 6px; top: 6px; min-height: 34px; }
.type-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.type-chip {
  min-height: 38px; padding: 0 14px; border-radius: 8px;
  border: 1px solid var(--line); background: #fff; font-size: 12.5px; color: var(--ink-2);
  transition: border-color .2s, background .2s, color .2s;
}
.type-chip:hover { border-color: var(--ink); }
.type-chip.is-selected { background: var(--accent); border-color: var(--accent); color: #fff; }
.type-chip.is-selected::after { content: " ✓"; }
.field-error { font-size: 11.5px; color: var(--accent); display: none; }
.field-error.is-visible { display: block; }

/* 支付 */
.pay-card { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 30px; }
.pay-card__sum { display: grid; gap: 12px; padding-bottom: 20px; border-bottom: 1px solid var(--line-soft); }
.pay-confirm { margin-top: 20px; padding: 20px; border: 1px solid var(--line); border-radius: 12px; background: var(--paper); }
.pay-confirm h2 { font-family: var(--font-display); font-size: 17px; margin-bottom: 10px; }
.pay-confirm ul { display: grid; gap: 8px; font-size: 12px; line-height: 1.7; color: var(--ink-2); }
.pay-confirm li { position: relative; padding-left: 15px; }
.pay-confirm li::before { content: "•"; position: absolute; left: 0; color: var(--accent); }
.pay-confirm li strong { color: var(--ink); }
.pay-confirm .notice__check { margin: 14px 0 0; color: var(--ink); font-weight: 600; }

.pay-qr { display: grid; place-items: center; padding: 28px 0 10px; }
.qr-box { width: 200px; height: 200px; background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: grid; place-items: center; }
.qr-box svg { width: 100%; height: 100%; }
.pay-qr p { font-size: 12px; color: var(--muted); margin-top: 12px; }
.pay-methods { display: flex; gap: 10px; justify-content: center; margin: 16px 0 4px; }
.pay-method { display: inline-flex; align-items: center; gap: 8px; padding: 9px 16px; border: 1px solid var(--line); border-radius: 999px; background: #fff; font-size: 12px; }
.pay-method.is-active { border-color: var(--green); background: var(--green-soft); color: var(--green); }
.pay-method i { width: 8px; height: 8px; border-radius: 50%; background: var(--green); }
.pay-safe { margin-top: 18px; padding: 14px; border-radius: 10px; background: var(--paper); font-size: 11.5px; color: var(--muted); line-height: 1.7; }
.pay-safe strong { color: var(--ink); }
.demo-note { margin-top: 12px; font-size: 16px; color: var(--muted-2); text-align: center; }

/* 任务中心 */
.success-hero { background: var(--ink); color: #fff; border-radius: var(--radius-lg); padding: 34px 34px 32px; position: relative; overflow: hidden; }
.success-hero::after { content: ""; position: absolute; right: -60px; top: -60px; width: 200px; height: 200px; border-radius: 50%; border: 1px solid rgba(255,255,255,.16); }
.success-hero__check { width: 46px; height: 46px; border-radius: 50%; background: rgba(255,255,255,.12); display: grid; place-items: center; margin-bottom: 18px; }
.success-hero__check svg { width: 24px; height: 24px; color: var(--accent-2); }
.success-hero h2 { font-family: var(--font-display); font-size: clamp(26px, 3vw, 34px); margin-bottom: 8px; }
.success-hero p { font-size: 16px; color: rgba(255,255,255,.66); }
.success-hero__meta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 20px; }
.meta-chip { padding: 6px 12px; border-radius: 999px; background: rgba(255,255,255,.1); font-size: 16px; color: rgba(255,255,255,.8); }
.meta-chip strong { color: #fff; font-weight: 500; }

.task-list { display: grid; gap: 12px; margin-top: 18px; }
.task {
  background: #fff; border: 1px solid var(--line); border-radius: var(--radius-md);
  padding: 20px 22px; display: flex; align-items: center; gap: 18px;
}
.task__icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: var(--paper-2); flex-shrink: 0; }
.task__icon svg { width: 20px; height: 20px; color: var(--ink-2); }
.task.is-done .task__icon { background: var(--green-soft); }
.task.is-done .task__icon svg { color: var(--green); }
.task__body { flex: 1; min-width: 0; }
.task__body h3 { font-size: 17px; display: flex; align-items: center; gap: 8px; }
.task__body p { font-size: 14px; line-height: 1.65; color: var(--muted); margin-top: 4px; }
.task__action { flex-shrink: 0; }
.task.is-done .task__action { color: var(--green); font-size: 14px; }

.order-timeline { margin-top: 26px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-md); padding: 24px; }
.order-timeline h3 { font-size: 16px; letter-spacing: .06em; margin-bottom: 18px; }
.timeline { display: grid; gap: 0; }
.tl-item { display: grid; grid-template-columns: 26px 1fr; gap: 14px; position: relative; padding-bottom: 18px; }
.tl-item:last-child { padding-bottom: 0; }
.tl-item::before { content: ""; position: absolute; left: 12px; top: 26px; bottom: 0; width: 1px; background: var(--line); }
.tl-item:last-child::before { display: none; }
.tl-dot { width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--line); background: #fff; display: grid; place-items: center; font-size: 12px; color: var(--muted); }
.tl-item.is-done .tl-dot { background: var(--green); border-color: var(--green); color: #fff; }
.tl-item.is-current .tl-dot { background: var(--accent); border-color: var(--accent); color: #fff; }
.tl-body b { display: block; font-size: 16px; }
.tl-body span { font-size: 11.5px; color: var(--muted); }
.tl-item.is-current .tl-body b { color: var(--accent); }

/* 弹窗 */
dialog.modal {
  width: min(calc(100% - 32px), 560px); padding: 0; border: 0; border-radius: 20px;
  box-shadow: var(--shadow-lg); background: #fff;
}
dialog.modal::backdrop { background: rgba(21,23,28,.48); backdrop-filter: blur(4px); }
.modal__head { display: flex; align-items: flex-start; gap: 12px; padding: 24px 26px 0; }
.modal__head h2 { font-family: var(--font-display); font-size: 22px; }
.modal__head p { font-size: 12px; color: var(--muted); margin-top: 4px; }
.modal__close { margin-left: auto; width: 34px; height: 34px; border-radius: 8px; border: 1px solid var(--line); background: #fff; display: grid; place-items: center; }
.modal__body { padding: 20px 26px; }
.modal__foot { padding: 16px 26px 24px; display: flex; gap: 10px; justify-content: flex-end; border-top: 1px solid var(--line-soft); }
.realname-steps { display: grid; gap: 10px; }
.rn-step { display: flex; gap: 14px; padding: 14px; border: 1px solid var(--line); border-radius: 12px; }
.rn-step__num { width: 24px; height: 24px; border-radius: 50%; background: var(--paper-2); display: grid; place-items: center; font-size: 16px; flex-shrink: 0; }
.rn-step h4 { font-size: 16px; }
.rn-step p { font-size: 11.5px; color: var(--muted); }
.rn-step.is-done { background: var(--green-soft); border-color: rgba(var(--accent2-rgb), .3); }
.rn-step.is-done .rn-step__num { background: var(--green); color: #fff; }

/* =========================================================
   资料表单（form.html）
   ========================================================= */
.form-page { background: var(--paper); }
.form-top { background: rgba(255,255,255,.94); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 50; backdrop-filter: blur(12px); }
.form-top__inner { min-height: 64px; display: flex; align-items: center; gap: 16px; }
.form-top__order { font-size: 12px; color: var(--muted); margin-left: auto; text-align: right; line-height: 1.5; }
.form-top__order strong { display: block; color: var(--ink); font-size: 12.5px; }
.form-shell { display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 40px; align-items: start; padding: 32px 0 120px; }
.form-nav { position: sticky; top: 88px; }
.form-nav h4 { font-size: 16px; letter-spacing: .12em; color: var(--muted); margin-bottom: 12px; }
.form-nav a { display: block; font-size: 12.5px; color: var(--muted); padding: 8px 0 8px 12px; border-left: 2px solid transparent; }
.form-nav a:hover, .form-nav a.is-active { color: var(--ink); border-left-color: var(--accent); }
.form-nav__progress { margin-top: 20px; padding: 14px; border-radius: 12px; background: #fff; border: 1px solid var(--line); font-size: 11.5px; color: var(--muted); }
.form-nav__progress b { display: block; color: var(--ink); font-size: 20px; font-family: var(--font-display); }
.form-nav__bar { height: 6px; border-radius: 999px; background: var(--paper-2); margin-top: 8px; overflow: hidden; }
.form-nav__bar i { display: block; height: 100%; width: 45%; background: var(--accent); }

.form-block { background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg); padding: 30px; margin-bottom: 18px; scroll-margin-top: 92px; }
.form-block__head { margin-bottom: 22px; }
.form-block__head h2 { font-family: var(--font-display); font-size: 24px; margin-bottom: 4px; }
.form-block__head p { font-size: 12px; color: var(--muted); }
.form-block__head .pill { margin-bottom: 8px; }

.rules-box { background: var(--accent-soft); border: 1px solid rgba(var(--accent-rgb),.18); border-radius: 12px; padding: 18px 20px; margin-bottom: 20px; }
.rules-box h4 { font-size: 12.5px; color: var(--accent-dark); margin-bottom: 8px; }
.rules-box ol { margin: 0; padding-left: 18px; display: grid; gap: 6px; font-size: 12.5px; color: var(--ink-2); }
.rules-box strong { color: var(--accent-dark); }
.rules-box__analogy { margin-top: 10px; color: var(--muted); font-size: 12px; }

.upload {
  border: 1.5px dashed var(--line); border-radius: var(--radius-md); background: var(--accent-soft);
  padding: 30px 20px; text-align: center; transition: border-color .2s, background .2s; cursor: pointer;
}
.upload:hover { border-color: var(--accent); background: rgba(var(--accent-rgb), 0.04); }
.upload.is-dragging { border-color: var(--accent); background: var(--accent-soft); box-shadow: 0 0 0 3px rgba(var(--accent-rgb), .12); }
.upload__icon { width: 42px; height: 42px; border-radius: 50%; background: var(--paper-2); display: grid; place-items: center; margin: 0 auto 12px; }
.upload h4 { font-size: 16px; }
.upload p { font-size: 11.5px; color: var(--muted); margin-top: 4px; }
.upload .upload__demo-note { font-size: 16px; color: var(--muted-2); }
.upload__files { display: flex; gap: 8px; justify-content: center; margin-top: 14px; flex-wrap: wrap; }
.file-chip { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 6px; background: var(--green-soft); color: var(--green); font-size: 16px; }
.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

.self-check { margin-top: 18px; border: 1px solid var(--line); border-radius: 12px; padding: 18px 20px; background: var(--paper); }
.self-check h4 { font-size: 12px; letter-spacing: .08em; color: var(--muted); margin-bottom: 10px; }
.self-check label { display: flex; gap: 10px; align-items: flex-start; font-size: 12.5px; padding: 6px 0; cursor: pointer; }
.self-check .checkbox { width: 18px; height: 18px; }
.self-check input { position: absolute; opacity: 0; }

.identity {
  display: flex; gap: 14px; align-items: center; padding: 16px 18px; border: 1px solid var(--line);
  border-radius: 12px; background: #fff; cursor: pointer;
}
.identity.is-selected { border-color: rgba(var(--accent-rgb), .45); background: var(--accent-soft); }
.identity__avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--paper-2); display: grid; place-items: center; font-size: 16px; }
.identity__body { flex: 1; }
.identity__body b { display: block; font-size: 13.5px; }
.identity__body span { font-size: 11.5px; color: var(--muted); }
.identity .pill { flex-shrink: 0; }
.identity-add { margin-top: 10px; font-size: 12px; color: var(--accent); }

.portrait-opts { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.portrait-opt { display: flex; gap: 12px; align-items: flex-start; padding: 16px; border: 1px solid var(--line); border-radius: 12px; cursor: pointer; background: #fff; }
.portrait-opt input { accent-color: var(--accent); margin-top: 2px; }
.portrait-opt.is-selected { border-color: rgba(var(--accent-rgb),.4); background: rgba(var(--accent-rgb), 0.04); }
.portrait-opt b { font-size: 16px; display: block; }
.portrait-opt span { font-size: 11.5px; color: var(--muted); }

.rights-grid { display: flex; flex-wrap: wrap; gap: 8px; }
.right-chip {
  padding: 8px 12px; border-radius: 8px; border: 1px solid var(--line); background: #fff;
  font-size: 12px; display: inline-flex; align-items: center; gap: 6px;
}
.right-chip.is-on { background: var(--green-soft); border-color: rgba(var(--accent2-rgb), .35); color: var(--green); }
.right-chip i { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }

.agree-box { display: flex; gap: 12px; align-items: flex-start; padding: 18px; border-radius: 12px; background: var(--paper); font-size: 12.5px; line-height: 1.7; }
.agree-box input { margin-top: 3px; accent-color: var(--accent); }

.error-summary { display: none; margin-bottom: 18px; border: 1px solid rgba(var(--accent-rgb),.35); background: var(--accent-soft); border-radius: 12px; padding: 16px 18px; }
.error-summary.is-visible { display: block; }
.error-summary h4 { font-size: 16px; color: var(--accent-dark); margin-bottom: 6px; }
.error-summary a { display: flex; gap: 8px; font-size: 12px; color: var(--accent-dark); padding: 4px 0; }

.form-actions {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
  background: rgba(255,255,255,.94); border-top: 1px solid var(--line); backdrop-filter: blur(12px);
}
.form-actions__inner { min-height: 72px; display: flex; align-items: center; gap: 12px; }
.form-actions__save { margin-right: auto; font-size: 11.5px; color: var(--muted); display: flex; align-items: center; gap: 8px; }
.form-actions__save i { width: 7px; height: 7px; border-radius: 50%; background: var(--green); }

/* 提示 */
.toast {
  position: fixed; left: 50%; bottom: 96px; transform: translate(-50%, 18px);
  background: var(--ink); color: #fff; padding: 12px 20px; border-radius: 999px;
  font-size: 12.5px; box-shadow: var(--shadow-md); opacity: 0; pointer-events: none;
  transition: opacity .25s, transform .25s; z-index: 90;
}
.toast.is-visible { opacity: 1; transform: translate(-50%, 0); }


/* =========================================================
   WHY 为什么值得登记
   ========================================================= */
.why-grid {
  display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: start;
  padding-top: 4px;
}
.why-panel { padding: 28px 32px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-md); }
.why-panel h3 { font-family: var(--font-display); font-size: 22px; margin-bottom: 14px; line-height: 1.4; }
.issue-list { list-style: none; padding: 0; margin: 0 0 18px; display: grid; gap: 10px; }
.issue-list li { display: flex; gap: 10px; align-items: flex-start; font-size: 16px; color: var(--ink); }
.issue-dot { flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); margin-top: 8px; }
.why-key { margin: 0; padding: 14px 16px; border-left: 2px solid var(--accent); background: var(--accent-soft); border-radius: 0 8px 8px 0; font-size: 13.5px; line-height: 1.7; }
.why-key strong { color: var(--accent-dark); }

.why-flow { display: grid; gap: 14px; }
.why-step {
  position: relative; padding: 18px 22px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-md);
  display: flex; gap: 14px; align-items: flex-start;
}
.why-step + .why-step::before {
  content: ""; position: absolute; top: -14px; left: 40px; width: 1px; height: 14px; background: var(--line);
}
.why-step__num {
  flex-shrink: 0; font-family: var(--font-display); font-size: 26px; font-weight: 700;
  color: var(--gold); line-height: 1; padding-top: 2px;
}
.why-step b { display: block; font-size: 16px; margin-bottom: 2px; color: var(--ink); }
.why-step span { font-size: 12.5px; color: var(--muted); }
.why-step--warn { border-color: rgba(var(--accent-rgb),.35); background: var(--accent-soft); }
.why-step--warn .why-step__num { color: var(--accent); }
.why-step--ok { border-color: rgba(var(--accent2-rgb), .35); background: var(--green-soft); }
.why-step--ok .why-step__num { color: var(--green); }

/* =========================================================
   TREND 今年的争议
   ========================================================= */
.trend-card {
  padding: 36px 40px; background: #fff; border: 1px solid var(--line);
  border-radius: var(--radius-lg); box-shadow: 0 4px 28px rgba(21,23,28,.04);
}
.trend-head h2 { font-family: var(--font-display); font-size: 30px; margin-bottom: 12px; line-height: 1.25; }
.trend-head p { max-width: 680px; color: var(--muted-1); font-size: 16px; line-height: 1.75; }

.case-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
  margin-top: 28px;
}
.case { padding: 20px; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-2); }
.case-tag {
  display: inline-block; font-size: 16px; padding: 3px 10px; border-radius: 4px;
  background: var(--accent-soft); color: var(--accent-dark); letter-spacing: .03em;
  margin-bottom: 10px; font-weight: 600;
}
.case p { font-size: 16px; line-height: 1.65; color: var(--ink); }

.trend-meter {
  margin-top: 28px; padding: 16px 22px; background: rgba(var(--accent-rgb), 0.04); border: 1px solid rgba(var(--accent-rgb),.25);
  border-radius: 12px; display: flex; gap: 16px; align-items: center; flex-wrap: wrap;
}
.trend-meter > span { font-size: 16px; color: var(--accent-dark); font-weight: 600; flex-shrink: 0; }
.meter-bar { flex: 1; height: 6px; background: rgba(var(--accent-rgb),.12); border-radius: 4px; overflow: hidden; min-width: 120px; }
.meter-bar i { display: block; height: 100%; width: 82%; background: linear-gradient(90deg, var(--accent), var(--gold)); border-radius: 4px; }
.trend-meter small { flex-basis: 100%; font-size: 11.5px; color: var(--muted); }

/* =========================================================
   VALUE 登记价值
   ========================================================= */
.value-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 32px;
}
.value-card {
  padding: 40px; background: var(--bg-2); border: none; border-radius: 20px;
  box-shadow: 0 4px 24px rgba(2, 8, 23, 0.04);
  transition: transform .3s var(--ease), box-shadow .3s var(--ease);
  position: relative; overflow: hidden;
}
.value-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
#exclusive .value-card:nth-child(1) { background: linear-gradient(135deg, rgb(209,233,255), rgb(255,233,233)); }
#exclusive .value-card:nth-child(2) { background: linear-gradient(135deg, rgb(219,235,255), rgb(255,236,236)); }
#exclusive .value-card:nth-child(3) { background: linear-gradient(135deg, rgb(255,248,210), rgb(250,234,255)); }
#exclusive .value-card__num { color: var(--accent); opacity: .6; }
#why .value-card { background: transparent; box-shadow: none; border-radius: 0; padding: 24px 0; border-bottom: 1px solid var(--line-soft); }
#why .value-card:last-child { border-bottom: none; }

/* 圆形图标容器（线上专属服务卡片装饰） */
#exclusive .value-card__num { display: none; }
#exclusive .card-icon {
  width: 100px; height: 100px; border-radius: 50%;
  background: #FFFFFF;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 20px;
  font-size: 40px;
  box-shadow: 0 4px 16px rgba(0,0,0,0.06);
}
#exclusive .card-icon svg, #exclusive .card-icon img { width: 52px; height: 52px; }

.value-card__num {
  display: inline-block; font-family: var(--font-display); font-size: 22px; font-weight: 700;
  color: var(--gold); margin-bottom: 10px;
}
.value-card h3 { font-family: var(--font-display); font-size: 19px; margin-bottom: 10px; line-height: 1.3; }
.value-card p { font-size: 13.5px; line-height: 1.75; color: var(--muted-1); }

/* =========================================================
   NOTICE 登记须知（介绍页概览版）
   ========================================================= */
.notice-grid-alt {
  display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; margin-top: 28px;
}
.notice-alt {
  padding: 22px 24px; background: #fff; border: 1px solid var(--line); border-radius: 14px;
  position: relative;
}
.notice-alt__num {
  font-family: var(--font-display); font-size: 16px; font-weight: 700;
  color: var(--accent); letter-spacing: .05em;
}
.notice-alt h3 { font-family: var(--font-display); font-size: 17px; margin: 4px 0 8px; line-height: 1.3; }
.notice-alt p { font-size: 16px; line-height: 1.7; color: var(--muted-1); }
.notice-alt p strong { color: var(--ink); }

/* =========================================================
   SYNC 同步组委会
   ========================================================= */
.sync-module {
  display: grid; grid-template-columns: .95fr 1.05fr; gap: 40px; align-items: center;
  margin-top: 28px; padding: 32px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-lg);
}
.sync-info h3 { font-family: var(--font-display); font-size: 20px; margin-bottom: 16px; }
.sync-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
.sync-list li {
  display: flex; gap: 16px; padding: 11px 0; border-bottom: 1px dashed var(--line);
  font-size: 16px;
}
.sync-list li:last-child { border-bottom: 0; }
.sync-list span { color: var(--muted); min-width: 80px; flex-shrink: 0; }
.sync-list b { color: var(--ink); font-weight: 500; }
.sync-note { margin-top: 16px; font-size: 12px; color: var(--muted); padding-top: 14px; border-top: 1px dashed var(--line); }

.sync-link {
  display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 14px;
}
.sync-card {
  padding: 20px 22px; border-radius: 14px; border: 1px solid var(--line); background: var(--paper);
}
.sync-card--a { border-color: rgba(var(--accent3-rgb), .35); }
.sync-card--b { border-color: rgba(var(--accent2-rgb), .35); background: var(--green-soft); }
.sync-card b { display: block; font-size: 16px; margin-bottom: 4px; font-family: var(--font-display); }
.sync-card small { font-size: 11.5px; color: var(--muted); }
.sync-arrow {
  font-size: 16px; color: var(--accent-dark); text-align: center; line-height: 1.5;
  writing-mode: vertical-rl; letter-spacing: .1em; font-weight: 600;
}

/* =========================================================
   赛事模板（event.html）
   ========================================================= */
/* =========================================================
   赛事模板（event.html）
   ========================================================= */
body[data-event="other"] { --accent: #1f5f4d; --accent-dark: #154638; --accent-soft: #e6f0eb; --gold: #b08a4b; }
body[data-event="other"] .hero__eyebrow { color: var(--accent); }
body[data-event="other"] .hero h1 em { color: var(--accent); }
body[data-event="other"] .site-header { background: rgba(244, 247, 244, .9); }
.event-banner { background: var(--accent); color: #fff; font-size: 12px; text-align: center; padding: 9px 16px; letter-spacing: .02em; }
.event-banner strong { font-weight: 600; }
.event-switch { appearance: none; border: 1px solid var(--line); background: #fff; border-radius: 999px; min-height: 36px; padding: 0 14px; font-size: 12px; }
.event-hero .hero__facts { border-top-color: rgba(255,255,255,.2); }
.event-disclaimer { font-size: 11.5px; color: var(--muted); background: var(--gold-soft); border: 1px solid rgba(var(--accent3-rgb), 0.25); border-radius: 12px; padding: 14px 18px; display: flex; gap: 10px; align-items: flex-start; }
.event-disclaimer strong { color: var(--ink); }
.event-config { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; margin-top: 18px; }
.event-config .cfg { background: #fff; border: 1px solid var(--line); border-radius: 12px; padding: 16px; }
.event-config .cfg span { font-size: 12px; letter-spacing: .1em; color: var(--muted); }
.event-config .cfg b { display: block; font-size: 16px; margin-top: 4px; }

/* =========================================================
   响应式
   ========================================================= */
@media (max-width: 1024px) {
  .nav { gap: 16px; }
  .nav__links { gap: 18px; }
  .hero__grid { grid-template-columns: 1fr; gap: 40px; }
  .cert-stage { min-height: 360px; }
  .cert { transform: rotate(0); }
  .compare-layout { grid-template-columns: 1fr; }
  .fit-grid { grid-template-columns: 1fr; }
  .flow { grid-template-columns: repeat(3, 1fr); row-gap: 28px; }
  .flow::before { display: none; }
  .price-grid { grid-template-columns: 1fr; }
  .prep-grid { grid-template-columns: repeat(2, 1fr); }
  .footer-grid { grid-template-columns: 1fr 1fr; }
  .funnel-shell { grid-template-columns: 1fr; }
  .summary-card { position: static; order: -1; }
  .form-shell { grid-template-columns: 1fr; }
  .form-nav { display: none; }
  .event-config { grid-template-columns: repeat(2, 1fr); }
  .why-grid { grid-template-columns: 1fr; gap: 24px; }
  .sync-module { grid-template-columns: 1fr; gap: 24px; }
  .sync-link { grid-template-columns: 1fr; }
  .sync-arrow { writing-mode: horizontal-tb; transform: rotate(90deg); margin: -4px auto; }
  .case-grid { grid-template-columns: repeat(2, 1fr); }
  .value-grid { grid-template-columns: repeat(3, 1fr); }
  .notice-grid-alt { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 820px) {
  .nav { min-height: 62px; }
  .nav__links {
    display: none; position: absolute; left: 0; right: 0; top: 62px;
    background: var(--paper); border-bottom: 1px solid var(--line);
    padding: 14px 24px 20px; flex-direction: column; align-items: flex-start; gap: 4px;
  }
  .nav__links.is-open { display: flex; }
  .nav__links a { display: block; width: 100%; padding: 10px 0; font-size: 16px; }
  .nav__links .event-switch { width: 100%; margin-top: 6px; }
  .nav__toggle { display: block; margin-left: auto; }
  .nav__actions .btn { display: none; }
  .nav__back { display: none; }
}

@media (min-width: 821px) and (max-width: 1024px) {
  .nav__pill { position: relative; }
  .nav__links {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    z-index: 5;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    padding: 14px 22px 18px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-md);
  }
  .nav__links.is-open { display: flex; }
  .nav__links a { padding: 9px 0; }
  .nav__toggle { display: block; }
}

@media (max-width: 760px) {
  .site-header { position: sticky; }
  .section { padding: 64px 0; }
  .hero { padding: 34px 0 44px; }
  .hero__lede { font-size: 16px; }
  .hero__facts { grid-template-columns: 1fr 1fr; row-gap: 14px; }
  .hero__fact:nth-child(3) { border-left: 0; padding-left: 0; }
  .hero__fact:nth-child(n+3) { border-top: 1px solid var(--line); padding-top: 14px; }
  .cert-stage { min-height: 330px; }
  .cert { width: min(100%, 360px); padding: 26px 22px 24px; }
  .cert__title { font-size: 22px; }
  .cert__seal { width: 66px; height: 66px; font-size: 12px; right: 18px; bottom: 18px; }
  .compare__canvas { aspect-ratio: 1 / 1.05; }
  .poster__kicker { display: none; }
  .cap-full { display: none; }
  .cap-short { display: inline; }
  .compare-row { grid-template-columns: 80px 1fr; }
  .flow { grid-template-columns: 1fr 1fr; }
  .flow-step__dot { width: 52px; height: 52px; font-size: 18px; }
  .prep-grid { grid-template-columns: 1fr; }
  .price-card, .refund-card { padding: 26px; }
  .price b { font-size: 48px; }
  .footer-grid { grid-template-columns: 1fr; gap: 24px; }
  .mobile-bar { display: flex; }
  body { padding-bottom: 76px; }
  .funnel-page, .form-page { padding-bottom: 0; }
  .stepper { overflow-x: auto; padding-bottom: 12px; scrollbar-width: none; }
  .stepper::-webkit-scrollbar { display: none; }
  .stepper__line { min-width: 12px; margin: 0 8px; }
  .form-grid { grid-template-columns: 1fr; }
  .form-card, .pay-card { padding: 20px; }
  .notice__body, .notice__check { margin-left: 0; }
  .prep-mini ul { grid-template-columns: 1fr; }
  .task { align-items: flex-start; flex-wrap: wrap; }
  .task__action { margin-left: 58px; width: calc(100% - 58px); }
  .task__action .btn { width: 100%; }
  .form-block { padding: 22px; }
  .portrait-opts { grid-template-columns: 1fr; }
  .event-config { grid-template-columns: 1fr; }
  .form-top__order { display: none; }
  .funnel-top__order { display: none; }
  .success-hero { padding: 26px; }
  .summary-card { padding: 20px; }
  .refund-table th, .refund-table td { padding: 10px 4px; font-size: 12px; }
  .refund-table td:last-child { white-space: normal; text-align: right; }
  .why-panel, .trend-card { padding: 24px; }
  .why-flow { gap: 10px; }
  .why-step { padding: 14px 16px; }
  .trend-head h2 { font-size: 24px; }
  .case-grid { grid-template-columns: 1fr; }
  .value-grid { grid-template-columns: 1fr; }
  .notice-grid-alt { grid-template-columns: 1fr; }
  .sync-module { padding: 20px; }
  .sync-card { padding: 16px 18px; }
}

@media (max-width: 420px) {
  .stepper__item { gap: 6px; }
  .stepper__label { font-size: 16px; }
  .stepper__line { min-width: 6px; margin: 0 4px; }
  .hero__actions .btn { width: 100%; }
  .why-panel { padding: 20px; }
  .why-step__num { font-size: 20px; }
  .trend-card { padding: 20px; }
  .case { padding: 16px; }
  .value-card { padding: 20px; }
  .value-card h3 { font-size: 17px; }
  .notice-alt { padding: 18px; }
  .sync-list li { gap: 10px; font-size: 12px; }
  .sync-list span { min-width: 68px; }
  .hero__facts { grid-template-columns: 1fr; }
  .hero__fact + .hero__fact { border-left: 0; padding-left: 0; }
  .flow { grid-template-columns: 1fr; }
  .compare__tag { font-size: 12px; padding: 4px 8px; }
}

/* ---------- Refined visual system: calm, legible, task first ---------- */
:root {
  --bg: #f5f7fa;
  --bg-2: #F9F9FC;
  --ink: #172538;
  --ink-2: #35465c;
  --muted: #657386;
  --muted-2: #8793a1;
  --line: rgba(30, 55, 83, .14);
  --line-soft: rgba(30, 55, 83, .08);
  --accent: #2856a8;
  --accent-dark: #1e437f;
  --accent-soft: #eaf0f8;
  --accent-2: #4d817d;
  --accent-3: #bd8a4c;
  --paper: #f5f7fa;
  --paper-2: #eef2f6;
  --green: #4d817d;
  --green-soft: #eaf2f0;
  --gold: #bd8a4c;
  --gold-soft: #f7f0e7;
  --amber: #a87437;
  --amber-soft: #f7f0e7;
  --shadow-sm: 0 2px 8px rgba(22, 39, 59, .05);
  --shadow-md: 0 10px 28px rgba(22, 39, 59, .08);
  --shadow-lg: 0 18px 48px rgba(22, 39, 59, .12);
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 22px;
  --font-display: "Outfit", "PingFang SC", "Noto Sans SC", "Microsoft YaHei", sans-serif;
  --font-sans: "PingFang SC", "Noto Sans SC", "Microsoft YaHei", system-ui, sans-serif;
  --accent-rgb: 40, 86, 168;
  --accent2-rgb: 77, 129, 125;
  --accent3-rgb: 189, 138, 76;
  --ink-rgb: 23, 37, 56;
}

html { scroll-padding-top: 104px; }
body {
  background: var(--bg);
  color: var(--ink);
  letter-spacing: .005em;
}
::selection { background: rgba(var(--accent-rgb), .2); color: var(--ink); }
.section { padding-block: clamp(56px, 7vw, 88px); }
.section--tight { padding-block: clamp(44px, 5vw, 64px); }
.section-head { max-width: 680px; margin-bottom: 36px; }
.section-head h2 { line-height: 1.3; letter-spacing: -.025em; }
.section-head p { line-height: 1.85; }
.eyebrow { letter-spacing: .08em; font-weight: 600; }
.eyebrow::before { width: 18px; height: 2px; }
.site-header { top: 8px; }
.nav__pill {
  background: rgba(255,255,255,.96);
  border: 1px solid rgba(23,37,56,.09);
  border-radius: 14px;
  box-shadow: 0 4px 18px rgba(22,39,59,.06);
  padding-inline: 20px;
}
.brand__mark { background: var(--accent); box-shadow: none; border-radius: 9px; }
.nav__links { gap: clamp(14px, 2vw, 24px); }
.btn { border-radius: 8px; font-weight: 600; }
.btn--primary {
  background: var(--accent);
  box-shadow: 0 4px 12px rgba(var(--accent-rgb), .16);
}
.btn--primary:hover { background: var(--accent-dark); box-shadow: 0 6px 16px rgba(var(--accent-rgb), .2); }
.btn--ghost { border-color: var(--line); }
.btn--ghost:hover { background: var(--accent-soft); border-color: rgba(var(--accent-rgb), .36); }
/* hero h1 由文件末尾视觉升级区接管，此处不重复定义 */
.hero {
  padding-top: clamp(42px, 6vw, 76px);
}
.hero__lede { max-width: 600px; line-height: 1.9; }
.hero__facts { border-top-color: var(--line); }
.hero__fact { border-color: var(--line); }
.cert-stage::before { background: rgba(var(--accent-rgb), .09); filter: blur(48px); }
.cert { box-shadow: 0 18px 42px rgba(22,39,59,.12); }
.cert__seal { background: #a8463a; box-shadow: none; }
.cert__sample {
  position: absolute;
  top: 14px;
  right: 14px;
  z-index: 2;
  padding: 4px 8px;
  border: 1px solid rgba(168,70,58,.24);
  border-radius: 4px;
  background: rgba(255,255,255,.94);
  color: #8d3e34;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .04em;
}
.compare, .why-panel, .trend-card, .value-card, .fit-card, .price-card,
.refund-card, .notice-alt, .prep-card, .form-block, .pay-card, .form-card {
  box-shadow: var(--shadow-sm);
}
.compare, .why-panel, .trend-card, .value-card, .fit-card, .price-card,
.refund-card, .notice-alt, .prep-card, .form-block, .pay-card, .form-card {
  border-color: var(--line-soft);
}
.compare__knob { border-radius: 50%; touch-action: none; }
.compare__tag { border-radius: 5px; }
.faq-tab { border-radius: 7px; }
details.faq { border-radius: 10px; }
.input, .select, .textarea {
  border-radius: 8px;
  border-color: rgba(30,55,83,.18);
  min-height: 46px;
}
.textarea { min-height: 120px; }
button:focus-visible, a:focus-visible, input:focus-visible, select:focus-visible,
textarea:focus-visible, [tabindex="0"]:focus-visible {
  outline: 3px solid rgba(var(--accent-rgb), .28);
  outline-offset: 3px;
}
.nav__links a:focus-visible { border-radius: 4px; }
.mobile-bar {
  background: rgba(255,255,255,.98);
  border-top: 1px solid var(--line);
  box-shadow: 0 -6px 20px rgba(22,39,59,.06);
}
.stepper__num { border-radius: 50%; }
.form-nav a { border-radius: 6px; }
.form-block { scroll-margin-top: 108px; }
.form-actions { background: rgba(255,255,255,.97); border-top-color: var(--line); }
.toast { border-radius: 8px; box-shadow: var(--shadow-md); }
.site-footer { background: #172538; }

@media (max-width: 820px) {
  .site-header { padding-inline: 16px; }
  .nav__pill { border-radius: 12px; }
  .nav__links {
    top: calc(100% + 8px);
    border: 1px solid var(--line);
    border-radius: 12px;
    box-shadow: var(--shadow-md);
    background: #fff;
    padding: 12px 18px 16px;
  }
  .nav__toggle { border-color: var(--line); border-radius: 8px; }
}
@media (max-width: 640px) {
  .section-head { margin-bottom: 26px; }
  .hero__actions { gap: 10px; }
  .hero__micro { line-height: 1.65; }
  .mobile-bar { padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); }
  .mobile-bar .btn { min-height: 46px; }
  .form-block { padding: 20px; }
  .step-head { margin-bottom: 24px; }
}
@media (min-width: 761px) and (max-width: 820px) {
  .mobile-bar { display: flex; }
  body { padding-bottom: 76px; }
}

/* ---------- 可读性统一：正文辅助文字不小于 13px，弱对比文字加深 ---------- */
.price-card__note { font-size: 13.5px; color: rgba(255,255,255,.74); line-height: 1.7; }
.refund-note, .summary-card__note, .pay-safe { font-size: 13.5px; line-height: 1.7; }
.pay-safe { color: var(--muted); }
.field .hint, .field-error, .counter, .pay-qr p, .pay-method,
.summary-card__micro, .tl-body span, .rn-step p, .form-nav__progress,
.form-block__head p, .modal__head p, .form-top__order { font-size: 13.5px; }
.prep-item b, .prep-item .mini, .refund-note { font-size: 13.5px; }
.compare-row dt, .fit-card__label, .flow-step__owner, .hero__fact span,
.faq-group h3 { font-size: 13.5px; }
.pay-confirm ul { font-size: 14.5px; line-height: 1.75; }
.hero__micro { font-size: 14px; line-height: 1.7; }
.cert__sample, .cert__issuer, .cert__sub { font-size: 13px; }
.funnel-top__order { font-size: 13.5px; }
.qr-chip em { font-size: 11.5px; }
.overlay-mark .chip { font-size: 13px; }

/* ---------- fit-card 三态区分更明显 ---------- */
.fit-card--full { border: 2px solid #2B9957; background: linear-gradient(180deg, rgba(43,153,87,.12), #fff 60%); }
.fit-card--partial { border: 2px solid #D97706; background: linear-gradient(180deg, rgba(217,119,6,.12), #fff 60%); }
.fit-card--no { border: 2px solid #D93025; background: linear-gradient(180deg, rgba(217,48,37,.10), #fff 60%); }
.fit-card__label {
  display: inline-block; padding: 6px 14px; border-radius: 999px;
  color: #fff; font-size: 14px; line-height: 1.4; letter-spacing: .08em; font-weight: 700;
}
.fit-card--full .fit-card__label { background: #2B9957; }
.fit-card--partial .fit-card__label { background: #D97706; }
.fit-card--no .fit-card__label { background: #D93025; }

/* ---------- price-grid 左右平衡 ---------- */
.price-grid { grid-template-columns: 1fr 1fr; gap: 20px; }
.refund-card {
  background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius-lg);
  padding: 32px; display: flex; flex-direction: column; gap: 16px;
}
.refund-card h3 { font-family: var(--font-display); font-size: 22px; }
.refund-card ul { display: grid; gap: 10px; font-size: 16px; line-height: 1.7; color: var(--ink-2); }
.refund-card li { position: relative; padding-left: 18px; }
.refund-card li::before { content: "•"; position: absolute; left: 0; color: var(--accent); font-weight: 700; }
.refund-info-block {
  border-top: 1px solid var(--line-soft); padding-top: 14px;
  display: flex; flex-direction: column; gap: 6px;
}
.refund-info-block strong { font-size: 13px; letter-spacing: .08em; color: var(--muted); }
.refund-info-block span { font-size: 15px; line-height: 1.65; color: var(--ink-2); }
.refund-info-block ul { display: grid; gap: 6px; margin: 0; padding-left: 18px; }

/* ---------- 新悬浮按钮 ---------- */
.float-buttons-wrap {
  position: fixed; right: 20px; bottom: 20px; z-index: 50;
  display: flex; flex-direction: column; gap: 12px; align-items: flex-end;
}
.float-button {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 12px 16px; border-radius: 999px; border: 0;
  font-size: 14px; font-weight: 600; cursor: pointer; text-decoration: none;
  box-shadow: 0 10px 28px rgba(16, 24, 40, 0.18);
  transition: transform .18s var(--ease), box-shadow .18s var(--ease);
}
.float-button:hover { transform: translateY(-2px); box-shadow: 0 14px 32px rgba(16, 24, 40, 0.22); }
.float-button--primary {
  background: var(--accent); color: #fff;
}
.float-button--secondary {
  background: #fff; color: var(--ink); border: 1px solid var(--line);
}
.float-button--ghost {
  width: 44px; height: 44px; padding: 0; justify-content: center;
  background: #fff; color: var(--ink); border: 1px solid var(--line);
}
.float-button-wrap { position: relative; }
.float-qr {
  position: absolute; right: 0; bottom: 58px; opacity: 0; transform: translateY(8px);
  pointer-events: none; transition: opacity .18s var(--ease), transform .18s var(--ease);
}
.float-button-wrap.is-open .float-qr,
.float-button-wrap:hover .float-qr {
  opacity: 1; transform: translateY(0); pointer-events: auto;
}
.float-qr__inner {
  background: #fff; border: 1px solid var(--line); border-radius: 14px;
  padding: 14px; box-shadow: 0 16px 36px rgba(16, 24, 40, 0.18);
}
.float-qr__box {
  width: 140px; height: 140px; background: #fff; border-radius: 8px; padding: 6px;
  box-shadow: inset 0 0 0 1px var(--line);
}
.float-qr__box svg, .float-qr__box img { width: 100%; height: 100%; display: block; object-fit: cover; }
.float-qr__inner p { margin: 8px 0 0; font-size: 12px; color: var(--muted); text-align: center; }

/* ---------- register.html notice 卡视觉升级 ---------- */
.notice-tabs { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 20px 0 14px; }
.notice-tab {
  display: flex; align-items: center; justify-content: space-between; gap: 8px;
  padding: 12px 16px; border: 1px solid var(--line); border-radius: 12px;
  background: #F5F7FC; color: var(--ink-2); font-size: 15px; font-weight: 600; text-align: left;
}
.notice-tab.is-active { background: var(--accent); border-color: var(--accent); color: #fff; }
.notice-tab.is-read:not(.is-active) { border-color: #2B9957; color: #2B9957; background: #F0FAF4; }
.notice-tab.is-read::after { content: "✓"; font-size: 17px; font-weight: 700; }
.funnel-step .notice-list { display: block; }
.funnel-step .notice { display: none; }
.funnel-step .notice.is-current {
  min-height: 300px; border: 1px solid rgba(var(--accent-rgb), .18); border-radius: var(--radius-md);
  background: linear-gradient(135deg, #fff 0%, #F3F7FF 100%);
  box-shadow: 0 12px 32px rgba(var(--accent-rgb), .08);
  padding: 24px 28px 20px; display: flex; flex-direction: column; gap: 12px; text-align: left;
}
.funnel-step .notice[hidden] { display: none; }
.funnel-step .notice__num {
  font-family: var(--font-display); font-size: 22px; font-weight: 700;
  color: var(--accent); width: 40px; height: 40px;
  display: grid; place-items: center; border-radius: 10px;
  background: rgba(var(--accent-rgb), 0.10); flex-shrink: 0;
}
.funnel-step .notice__top { align-items: flex-start; text-align: left; }
.funnel-step .notice__top h3 { font-size: 20px; margin: 0 0 4px; color: var(--ink); text-align: left; }
.funnel-step .notice__top p { font-size: 15px; line-height: 1.7; color: var(--muted); text-align: left; }
.funnel-step .notice__body { margin-left: 0; font-size: 16px; line-height: 1.7; color: var(--ink-2); text-align: left; }
.funnel-step .notice__body ul { display: grid; gap: 8px; }
.funnel-step .notice__body li { position: relative; padding-left: 16px; }
.funnel-step .notice__body li::before {
  content: ""; position: absolute; left: 2px; top: .62em;
  width: 5px; height: 5px; border-radius: 50%; background: var(--accent);
}
.funnel-step .notice__check {
  display: flex; align-items: center; gap: 10px;
  padding: 12px 14px; background: rgba(var(--accent-rgb), 0.06);
  border-radius: 10px; margin-top: auto; margin-left: 0;
  font-size: 15px; color: var(--ink); cursor: pointer; user-select: none; text-align: left;
}
@media (max-width: 900px) {
  .notice-tabs { grid-template-columns: repeat(2, 1fr); }
  .float-button { font-size: 13px; padding: 10px 14px; }
  .float-button span { display: none; }
}

/* ---------- footer：与线上版本一致 ---------- */
.site-footer {
  background: linear-gradient(92.1deg, #C8A9B1 .56%, #B4A3BF);
  color: #fff; padding: 80px 0 20px; font-size: 14px; text-align: left;
}
.footer-container {
  display: grid; grid-template-columns: 1.1fr 2fr .8fr; gap: 48px; align-items: start;
}
.footer-logo { display: flex; align-items: center; gap: 12px; color: #fff; }
.footer-logo img { width: 40px; height: 40px; object-fit: contain; }
.footer-logo strong { font-size: 18px; white-space: nowrap; }
.footer-nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; }
.footer-nav-column { display: grid; align-content: start; gap: 12px; }
.footer-nav-column a { color: #fff; font-size: 14px; line-height: 1.8; opacity: .9; }
.footer-nav-column a:hover { opacity: 1; text-decoration: underline; }
.footer-qrcode { justify-self: end; color: #fff; text-align: center; font-size: 14px; }
.footer-qrcode img {
  width: 104px; height: 104px; padding: 6px; object-fit: cover;
  background: #fff; border-radius: 4px;
}
.footer-qrcode p { margin-top: 10px; }
.site-footer .footer-bottom {
  margin-top: 48px; padding-top: 20px; border-top: 1px solid rgba(255,255,255,.28);
  display: flex; justify-content: center; gap: 24px; flex-wrap: wrap;
  color: rgba(255,255,255,.86); font-size: 13px; text-align: center;
}
@media (max-width: 900px) {
  .site-footer { padding-top: 48px; }
  .footer-container { grid-template-columns: 1fr 1fr; gap: 32px; }
  .footer-logo { grid-column: 1 / -1; }
  .footer-qrcode { justify-self: start; }
}
@media (max-width: 640px) {
  .footer-container { grid-template-columns: 1fr; }
  .footer-logo { grid-column: auto; }
  .footer-nav { gap: 20px; }
  .site-footer .footer-bottom { flex-direction: column; gap: 8px; }
}

/* ---------- summary-card 只在 step 3 显示 ---------- */
.summary-card { display: none; }
.funnel-shell:has([data-panel="3"].funnel-step.is-active) .summary-card { display: block; }

/* bump version v111 */
/* =========================================================
   视觉升级：几何网格 + 柔和光晕 + 渐变文字（Watermelon UI 风）
   ========================================================= */

/* ---------- Hero 几何网格背景 + 光晕 ---------- */
.hero {
  background:
    radial-gradient(ellipse 80% 60% at 85% 20%, rgba(var(--accent-rgb), 0.14) 0%, transparent 70%),
    radial-gradient(ellipse 60% 50% at 10% 90%, rgba(var(--accent3-rgb), 0.10) 0%, transparent 65%),
    url('banner.png') center / cover no-repeat,
    linear-gradient(160deg, #f0f4fb 0%, #fafbfe 60%, #f5f7fa 100%);
}
.hero::before {
  background:
    linear-gradient(180deg, rgba(255,255,255,0.88) 0%, rgba(255,255,255,0.94) 40%, rgba(255,255,255,0.96) 100%);
}
/* 网格点阵叠加 */
.hero::after {
  content: ""; position: absolute; inset: 0;
  background-image:
    radial-gradient(circle, rgba(var(--accent-rgb), 0.18) 1px, transparent 1px);
  background-size: 22px 22px;
  mask-image: radial-gradient(ellipse 75% 70% at 50% 45%, #000 30%, transparent 75%);
  -webkit-mask-image: radial-gradient(ellipse 75% 70% at 50% 45%, #000 30%, transparent 75%);
  pointer-events: none;
}

/* Hero H1 渐变文字 */
.hero h1 em {
  background: linear-gradient(135deg, var(--accent) 0%, #6B8FD6 45%, var(--accent-3) 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  font-style: normal;
}

/* ---------- Nav pill 装饰性网格 ---------- */
.nav__pill::before {
  content: ""; position: absolute; inset: 0; border-radius: inherit;
  background-image: radial-gradient(circle, rgba(var(--accent-rgb), 0.12) 1px, transparent 1px);
  background-size: 16px 16px;
  opacity: .45; pointer-events: none;
  border-radius: 14px;
  z-index: 0;
}
.nav__pill > * { position: relative; z-index: 1; }

/* ---------- 主按钮渐变 + 精致阴影 ---------- */
.btn--primary {
  background: linear-gradient(135deg, var(--accent) 0%, #3a6bc4 100%);
  box-shadow: 0 4px 14px rgba(var(--accent-rgb), 0.22);
  position: relative;
  overflow: hidden;
}
.btn--primary::before {
  content: ""; position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(255,255,255,0.18) 0%, transparent 55%);
  pointer-events: none;
}
.btn--primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 26px rgba(var(--accent-rgb), 0.30);
  background: linear-gradient(135deg, var(--accent-dark) 0%, var(--accent) 100%);
}

/* ---------- Value cards hover 光晕 ---------- */
.value-card {
  position: relative;
  transition: transform .35s var(--ease), box-shadow .35s var(--ease), border-color .35s;
  overflow: hidden;
}
.value-card::before {
  content: ""; position: absolute; top: -40px; right: -40px; width: 180px; height: 180px;
  background: radial-gradient(circle, rgba(var(--accent-rgb), 0.12) 0%, transparent 70%);
  opacity: 0; transition: opacity .35s var(--ease);
  pointer-events: none;
}
.value-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 16px 40px rgba(22,39,59,0.10);
  border-color: rgba(var(--accent-rgb), 0.22);
}
.value-card:hover::before { opacity: 1; }

/* ---------- Fit cards hover ---------- */
.fit-card { transition: transform .3s var(--ease), box-shadow .3s var(--ease); }
.fit-card:hover { transform: translateY(-3px); box-shadow: 0 14px 34px rgba(22,39,59,0.08); }

/* ---------- Price card 光晕边框 ---------- */
.price-card {
  background: linear-gradient(160deg, #0f1d34 0%, #1a2b48 60%, #0f1d34 100%);
  position: relative;
  overflow: hidden;
}
.price-card::before {
  content: ""; position: absolute; inset: 0;
  background:
    radial-gradient(ellipse 60% 50% at 100% 0%, rgba(var(--accent-rgb), 0.35) 0%, transparent 65%),
    radial-gradient(ellipse 50% 40% at 0% 100%, rgba(var(--accent3-rgb), 0.18) 0%, transparent 60%);
  pointer-events: none;
}
.price-card::after {
  content: ""; position: absolute; inset: 0;
  background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px);
  background-size: 18px 18px;
  pointer-events: none;
}
.price-card > * { position: relative; z-index: 1; }
.price-card .price b {
  background: linear-gradient(135deg, #fff 0%, #c5d4f7 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* ---------- Section 装饰性网格背景（paper 区块） ---------- */
.section--paper {
  background-image:
    radial-gradient(circle, rgba(var(--accent-rgb), 0.045) 1px, transparent 1px);
  background-size: 22px 22px;
}
.section--white {
  background-image:
    radial-gradient(circle, rgba(var(--ink-rgb), 0.035) 1px, transparent 1px);
  background-size: 26px 26px;
}

/* ---------- 流程步骤连接线：虚线 + 脉冲 ---------- */
.flow::before {
  border-top: 2px dashed var(--line);
  opacity: 0.7;
}
.flow-step__dot {
  position: relative;
  transition: transform .3s var(--ease), box-shadow .3s var(--ease);
}
.flow-step__dot::after {
  content: ""; position: absolute; inset: -4px; border-radius: 50%;
  border: 1px solid transparent;
  transition: border-color .3s var(--ease);
}
.flow-step:hover .flow-step__dot {
  transform: scale(1.06);
  box-shadow: 0 8px 20px rgba(var(--accent-rgb), 0.14);
}
.flow-step.is-critical .flow-step__dot {
  animation: pulse-accent 2.8s ease-in-out infinite;
}
@keyframes pulse-accent {
  0%, 100% { box-shadow: 0 0 0 0 rgba(var(--accent-rgb), 0.45); }
  50% { box-shadow: 0 0 0 10px rgba(var(--accent-rgb), 0); }
}

/* ---------- Compare 模块精致化 ---------- */
.compare { border-color: rgba(var(--accent-rgb), 0.14); }
.compare:hover { border-color: rgba(var(--accent-rgb), 0.28); }

/* ---------- FAQ 卡片 hover ---------- */
details.faq { transition: border-color .25s var(--ease), box-shadow .25s var(--ease); }
details.faq:hover { border-color: rgba(var(--accent-rgb), 0.25); }
details.faq[open] {
  border-color: rgba(var(--accent-rgb), 0.35);
  box-shadow: 0 4px 16px rgba(var(--accent-rgb), 0.08);
}

/* ---------- Hero facts 精致底纹 ---------- */
.hero__facts {
  position: relative;
  padding-top: 14px;
  border-top: 1px solid var(--line);
}

/* ---------- 证书光泽 ---------- */
.cert {
  position: relative;
  overflow: hidden;
}
.cert::after {
  content: ""; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%;
  background: linear-gradient(
    45deg,
    transparent 30%,
    rgba(255,255,255,0.35) 50%,
    transparent 70%
  );
  transform: translateX(-100%);
  transition: transform 0.8s var(--ease);
  pointer-events: none;
}
.cert:hover::after { transform: translateX(100%); }

/* ---------- Value card num 更有层次感 ---------- */
.value-card__num {
  font-family: var(--font-mono);
  font-size: 14px;
  letter-spacing: 0.08em;
  color: var(--accent);
  opacity: .7;
  margin-bottom: 14px;
}

/* ---------- Eyebrow 标签精致化 ---------- */
.eyebrow {
  display: inline-flex; align-items: center; gap: 10px;
  padding: 6px 14px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(255,255,255,0.7);
  backdrop-filter: blur(6px);
}
.eyebrow::before {
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 8px rgba(var(--accent-rgb), 0.5);
}

/* ---------- Section head 节奏更慢 ---------- */
.section-head h2 {
  position: relative;
  padding-bottom: 16px;
}
.section-head h2::after {
  content: ""; position: absolute; bottom: 0; left: 0;
  width: 40px; height: 3px; border-radius: 2px;
  background: linear-gradient(90deg, var(--accent), transparent);
}

/* ---------- Trend 卡片网格底纹 ---------- */
.trend-card {
  background-image:
    radial-gradient(circle, rgba(var(--accent-rgb), 0.06) 1px, transparent 1px);
  background-size: 20px 20px;
  position: relative;
}

/* ---------- 响应式：hero 网格在小屏减弱 ---------- */
@media (max-width: 760px) {
  .hero::after { background-size: 16px 16px; opacity: .6; }
  .price-card::before { opacity: .7; }
}

/* =========================================================
   组件替换：Hero Stats + Price Grid 3列 + Refund Light
   (Watermelon UI 参考)
   ========================================================= */

/* ---------- Hero Stats（替换旧 hero__facts） ---------- */
.hero__stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-top: 38px;
  padding-top: 24px;
  border-top: 1px solid rgba(var(--ink-rgb), 0.08);
}
.hero-stat {
  position: relative;
  padding: 18px 18px 16px;
  background: rgba(255,255,255,0.75);
  border: 1px solid rgba(var(--ink-rgb), 0.07);
  border-radius: 14px;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  transition: transform .3s var(--ease), box-shadow .3s var(--ease), border-color .3s;
  overflow: hidden;
}
.hero-stat::before {
  content: ""; position: absolute; top: 0; left: 0; right: 0; height: 2px;
  background: linear-gradient(90deg, rgba(var(--accent-rgb), 0.5) 0%, transparent 70%);
  opacity: 0; transition: opacity .3s var(--ease);
}
.hero-stat:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 28px rgba(22,39,59,0.08);
  border-color: rgba(var(--accent-rgb), 0.20);
}
.hero-stat:hover::before { opacity: 1; }
.hero-stat__label {
  display: inline-block;
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--muted);
  margin-bottom: 10px;
}
.hero-stat__num {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(22px, 3vw, 28px);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: -0.02em;
  color: var(--ink);
  margin-bottom: 8px;
}
.hero-stat__num small {
  font-size: 13px;
  font-weight: 500;
  color: var(--muted);
  margin-left: 4px;
  letter-spacing: 0;
}
.hero-stat__sub {
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--muted);
  margin: 0;
}

/* ---------- Price Grid 3列布局 ---------- */
.price-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 22px;
  align-items: stretch;
}
/* 费用说明：价格卡 + 退款卡 2 列 */
.price-grid--two {
  grid-template-columns: 1.1fr 1fr;
  gap: 24px;
}
.price-grid--two .price-card--featured { transform: none; box-shadow: 0 16px 40px rgba(22,39,59,0.20); }
@media (max-width: 960px) {
  .price-grid { grid-template-columns: 1fr 1fr; }
  .price-grid--two { grid-template-columns: 1fr; }
  .refund-card--light { grid-column: 1 / -1; }
}
@media (max-width: 600px) {
  .price-grid { grid-template-columns: 1fr; }
  .price-grid--two { grid-template-columns: 1fr; }
}

/* ---------- Price Card Featured（Popular 标记） ---------- */
.price-card--featured {
  position: relative;
  transform: translateY(-4px);
  box-shadow: 0 20px 48px rgba(22,39,59,0.22);
  border-color: rgba(var(--accent-rgb), 0.35);
}
.price-card__badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  position: absolute;
  top: -11px; left: 50%; transform: translateX(-50%);
  padding: 4px 14px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.04em;
  color: #0f1d34;
  background: linear-gradient(135deg, #FFD66B 0%, #FFB84D 100%);
  border-radius: 999px;
  white-space: nowrap;
  box-shadow: 0 4px 12px rgba(255,184,77,0.35);
  z-index: 2;
}
.price-card__badge::before {
  content: "★"; font-size: 10px;
}

/* ---------- Price Card 头部信息 ---------- */
.price-card__plan {
  font-family: var(--font-display);
  font-size: 18px;
  font-weight: 600;
  color: #fff;
  margin: 18px 0 6px;
}
.price-card__desc {
  font-size: 13.5px;
  line-height: 1.6;
  color: rgba(255,255,255,0.62);
  margin: 0 0 18px;
}
.price-card__label {
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--accent);
  opacity: .9;
  margin-bottom: 10px;
}
.price__meta {
  font-size: 12px;
  color: rgba(255,255,255,0.55);
  margin: 4px 0 18px;
}

/* ---------- Refund Card 浅色版 ---------- */
.refund-card--light {
  background: linear-gradient(160deg, #ffffff 0%, #f8faff 100%);
  border: 1px solid rgba(var(--accent-rgb), 0.18);
  border-radius: 20px;
  padding: 28px;
  position: relative;
  overflow: hidden;
}
.refund-card--light::before {
  content: ""; position: absolute; top: -30px; right: -30px;
  width: 160px; height: 160px; border-radius: 50%;
  background: radial-gradient(circle, rgba(var(--accent-rgb), 0.08) 0%, transparent 70%);
  pointer-events: none;
}
.refund-card--light h3 { color: var(--ink); }
.refund-card--light p { color: var(--muted); }
.refund-card--light .refund-info-block {
  background: rgba(var(--accent-rgb), 0.035);
  border: 1px solid rgba(var(--accent-rgb), 0.10);
  border-radius: 12px;
  padding: 14px 16px;
  margin-top: 12px;
}
.refund-card--light .refund-info-block strong {
  color: var(--ink);
  font-size: 13px;
  display: block;
  margin-bottom: 4px;
}
.refund-card--light .refund-note {
  margin-top: 16px;
  padding: 10px 14px;
  background: rgba(var(--accent-rgb), 0.05);
  border-radius: 10px;
  font-size: 13px;
  color: var(--muted);
  display: flex; align-items: center; gap: 8px;
}

/* ---------- Hero Stats 响应式 ---------- */
@media (max-width: 760px) {
  .hero__stats { grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 28px; padding-top: 18px; }
  .hero-stat { padding: 14px; }
  .hero-stat__label { font-size: 10px; margin-bottom: 6px; }
  .hero-stat__num { font-size: 20px; }
  .hero-stat__sub { font-size: 12px; }
}
@media (max-width: 400px) {
  .hero__stats { grid-template-columns: 1fr; }
}


