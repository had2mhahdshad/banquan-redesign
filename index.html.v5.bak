<!-- 微信扫码登录弹层（原型） -->
<dialog class="modal" id="wxLoginDialog">
  <div class="modal__head">
    <div>
      <h2>请先登录</h2>
      <p>使用微信扫码登录后，可继续版权登记流程。</p>
    </div>
    <button class="modal__close" id="wxLoginClose" type="button" aria-label="关闭">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>
  <div class="modal__body" style="display:flex;flex-direction:column;align-items:center;padding:18px 24px 24px">
    <div class="float-qr__box" style="width:180px;height:180px;margin:0 auto 12px">
      <svg viewBox="0 0 21 21" fill="#101828"><rect x="0" y="0" width="7" height="7"/><rect x="1.5" y="1.5" width="4" height="4" fill="#fff"/><rect x="3" y="3" width="1" height="1"/><rect x="14" y="0" width="7" height="7"/><rect x="15.5" y="1.5" width="4" height="4" fill="#fff"/><rect x="17" y="3" width="1" height="1"/><rect x="0" y="14" width="7" height="7"/><rect x="1.5" y="15.5" width="4" height="4" fill="#fff"/><rect x="3" y="17" width="1" height="1"/><rect x="9" y="1" width="1" height="1"/><rect x="10" y="3" width="1" height="1"/><rect x="9" y="5" width="1" height="1"/><rect x="12" y="2" width="1" height="1"/><rect x="1" y="9" width="1" height="1"/><rect x="3" y="10" width="1" height="1"/><rect x="5" y="9" width="1" height="1"/><rect x="2" y="12" width="1" height="1"/><rect x="9" y="9" width="1" height="1"/><rect x="11" y="10" width="1" height="1"/><rect x="10" y="12" width="1" height="1"/><rect x="13" y="9" width="1" height="1"/><rect x="16" y="9" width="1" height="1"/><rect x="18" y="11" width="1" height="1"/><rect x="15" y="12" width="1" height="1"/><rect x="16" y="15" width="1" height="1"/><rect x="18" y="16" width="1" height="1"/><rect x="17" y="19" width="1" height="1"/><rect x="15" y="18" width="1" height="1"/><rect x="20" y="18" width="1" height="1"/></svg>
    </div>
    <p style="font-size:14px;color:var(--muted);margin:4px 0 14px">微信扫码 · 原型演示</p>
    <button class="btn btn--primary" type="button" id="wxLoginSimulate">我已扫码，模拟登录成功</button>
  </div>
</dialog>

<script>
(function(){
  var LOGIN_KEY = 'dqg_logged_in';
  var logged = !!localStorage.getItem(LOGIN_KEY);
  var dialog = document.getElementById('wxLoginDialog');
  if (!dialog) return;
  document.getElementById('wxLoginClose').addEventListener('click', function(){ dialog.close(); });
  var pendingHref = null;
  document.getElementById('wxLoginSimulate').addEventListener('click', function(){
    localStorage.setItem(LOGIN_KEY, '1');
    logged = true;
    dialog.close();
    if (pendingHref) {
      // 当前页跳转（不新开标签，避免 register.html 登录态丢失）
      window.location.href = pendingHref;
      pendingHref = null;
      return;
    }
  });
  document.addEventListener('click', function(e){
    var a = e.target.closest('[data-goto-register]');
    if (!a) return;
    e.preventDefault();
    e.stopPropagation();
    pendingHref = a.getAttribute('href') || 'register.html';
    if (logged) {
      window.location.href = pendingHref;
      pendingHref = null;
      return;
    }
    dialog.showModal();
  }, true);
  document.querySelectorAll('.float-button-wrap').forEach(function(wrap){
    wrap.addEventListener('mouseenter', function(){ wrap.classList.add('is-open'); });
    wrap.addEventListener('mouseleave', function(){ wrap.classList.remove('is-open'); });
  });
})();
</script>
</body>
